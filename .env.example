# Docker Compose MySQL settings
MYSQL_DATABASE=wealthcopilot
MYSQL_USER=wealthcopilot
MYSQL_PASSWORD=wealthcopilot_dev
MYSQL_ROOT_PASSWORD=wealthcopilot_root_dev
MYSQL_PORT=3306

# Spring Boot settings (defaults match the Compose values above)
DB_URL=jdbc:mysql://localhost:3306/wealthcopilot?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=wealthcopilot
DB_PASSWORD=wealthcopilot_dev
SERVER_PORT=8080
FRONTEND_ORIGIN=http://localhost:5173

# JWT settings (use a unique secret with at least 32 characters outside local development)
JWT_SECRET=wealthcopilot-dev-only-secret-change-me-2026
JWT_EXPIRATION_SECONDS=3600
