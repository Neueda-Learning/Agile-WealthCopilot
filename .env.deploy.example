# Copy to .env.deploy and replace every CHANGE_ME value.
MYSQL_DATABASE=wealthcopilot
MYSQL_USER=wealthcopilot
MYSQL_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD

# At least 32 random characters. Example generator: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_WITH_AT_LEAST_32_CHARACTERS

# Public host port for the backend.
APP_PORT=8080
